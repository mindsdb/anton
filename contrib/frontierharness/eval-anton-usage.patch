+def _anton(text: str) -> Detail:
+    # ANTON_USAGE_LOG lines on stderr: "llm_usage {json}", input is fresh-only.
+    prefix = "llm_usage "
+    records = "\n".join(line[len(prefix):] for line in text.splitlines() if line.startswith(prefix))
+    usages = []
+    for event in _jsonl(records):
+        fresh = int(event.get("input") or 0)
+        cached = int(event.get("cache_read") or 0)
+        cache_write = int(event.get("cache_creation") or 0)
+        if fresh or cached or cache_write or event.get("output"):
+            usages.append((fresh + cached + cache_write, cached))
+    return _detail(usages)
+
