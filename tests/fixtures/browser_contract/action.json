{
  "description": "POST /sessions/{id}/action: one step. x and y with coords \"screenshot\" are pixels on the latest screenshot, which the host scales back to the page. A point wins over an element when a step has both. A step settles before the host answers: when it started a main-frame request or a navigation, the host waits until those requests are done and the page has shown no change for settle_quiet_ms, at most settle_max_ms (a navigation also waits for its new page's network, as before); a step that started neither answers at once. changed says whether the step changed what the page shows: true, false, or null when the host can't tell (a frame, canvas or media element in view or under the step, a closed shadow root, a hover, a wait, a read, or a page it couldn't watch). The answer carries the page after the step when include_page is true.",
  "limits": {
    "settle_max_ms": 3000,
    "settle_quiet_ms": 400
  },
  "examples": {
    "click an element": {
      "where": "POST /sessions/{id}/action",
      "kind": "request",
      "body": {
        "action": "click",
        "element": 7,
        "include_page": true
      }
    },
    "type and submit": {
      "where": "POST /sessions/{id}/action",
      "kind": "request",
      "body": {
        "action": "type",
        "element": 1,
        "text": "MacBook Air",
        "submit": true,
        "include_page": true
      }
    },
    "click at a point on the screenshot": {
      "where": "POST /sessions/{id}/action",
      "kind": "request",
      "body": {
        "action": "click",
        "x": 412,
        "y": 230,
        "include_page": true,
        "coords": "screenshot"
      }
    },
    "press Enter in an element": {
      "where": "POST /sessions/{id}/action",
      "kind": "request",
      "body": {
        "action": "press",
        "key": "Enter",
        "element": 2,
        "include_page": true
      }
    },
    "drag from an element to a point": {
      "where": "POST /sessions/{id}/action",
      "kind": "request",
      "body": {
        "action": "drag",
        "from": {
          "element": 5
        },
        "to": {
          "x": 600,
          "y": 300
        },
        "include_page": true,
        "coords": "screenshot"
      }
    },
    "the answer with the page after": {
      "where": "POST /sessions/{id}/action",
      "kind": "response",
      "status": 200,
      "body": {
        "ok": true,
        "url": "https://shop.example.test/cart",
        "changed": true,
        "page": {
          "url": "https://shop.example.test/cart",
          "title": "Your cart",
          "scroll": {
            "y": 0,
            "height": 2400,
            "viewport": 800
          },
          "elements": [
            {
              "id": 1,
              "role": "searchbox",
              "name": "Search"
            },
            {
              "id": 2,
              "role": "textbox",
              "name": "Gift message",
              "value": "Happy birthday"
            },
            {
              "id": 3,
              "role": "button",
              "name": "Place order"
            }
          ],
          "truncated": true,
          "text": "Your cart. 1 item. Total $999.",
          "challenges": [],
          "frames": []
        }
      }
    },
    "the answer without a page": {
      "where": "POST /sessions/{id}/action",
      "kind": "response",
      "status": 200,
      "body": {
        "ok": true,
        "url": "https://shop.example.test/cart",
        "changed": true
      }
    },
    "a step that changed nothing": {
      "where": "POST /sessions/{id}/action",
      "kind": "response",
      "status": 200,
      "body": {
        "ok": true,
        "url": "https://shop.example.test/cart",
        "changed": false
      }
    }
  }
}
